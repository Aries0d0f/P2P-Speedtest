/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "p2p-speedtest",
	"compatibility_date": "2026-07-28",
	"main": "./workers/app.ts",
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "SIGNALING_ROOM", "class_name": "SignalingRoom" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SignalingRoom"] }
	],
	/**
	 * Rate Limiting (S10) — one namespace/policy per binding, keyed on
	 * CF-Connecting-IP at the Worker (workers/app.ts).
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	 */
	"ratelimits": [
		{
			"name": "CREATE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "JOIN_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	/**
	 * Static Assets - the prerendered "/" page and the SPA-fallback shell
	 * for "/room/:slug" (react-router.config.ts: ssr:false, prerender:true).
	 * not_found_handling is "none" so an unmatched path reaches the Worker,
	 * which serves the SPA fallback itself (workers/app.ts) rather than
	 * Cloudflare's built-in index.html fallback.
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": { "directory": "./build/client", "binding": "ASSETS", "not_found_handling": "none" },
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": {  "mode": "smart" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
